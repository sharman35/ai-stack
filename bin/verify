#!/usr/bin/env python3
"""Read-only post-install checks; does not spend provider tokens."""
import json
from pathlib import Path
import subprocess
import urllib.request
import urllib.error

root = Path(__file__).resolve().parents[1]
env = dict(l.split('=', 1) for l in (root / '.env').read_text().splitlines() if l and not l.startswith('#'))
subprocess.run(['docker', 'compose', 'config', '--quiet'], cwd=root, check=True)
base = 'http://' + env['NETBIRD_IP']
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))

def get(url, key=None):
    req = urllib.request.Request(url, headers={'Authorization': 'Bearer ' + key} if key else {})
    return json.load(opener.open(req, timeout=20))

status = get(base + ':9119/api/status')
assert status.get('auth_required') is True and 'basic' in status.get('auth_providers', []), 'Dashboard auth gate not active'
for port in [8317, 8642]:
    try:
        get(base + f':{port}/v1/models')
    except urllib.error.HTTPError as e:
        assert e.code in (401, 403), f'Unexpected unauthenticated response: {e.code}'
    else:
        raise AssertionError(f'API {port} allowed unauthenticated models request')
models = get(base + ':8317/v1/models', env['CLIPROXY_KEY'])
print('PASS: dashboard basic auth active; both API endpoints reject unauthenticated requests.')
print('Authorized CLIProxy model IDs:', [m['id'] for m in models.get('data', [])])
if not models.get('data'):
    raise SystemExit('No provider models yet. Complete CLIProxy authorization; inference NOT verified.')
print('Model discovery passed. Run a paid/authorized chat separately to verify inference.')
